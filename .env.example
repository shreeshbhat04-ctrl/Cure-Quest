# App
APP_NAME=Cure-Quest
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./cure_quest.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cure_quest
# Example AlloyDB-compatible SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cure_quest

# Brain transport
BRAIN_GATEWAY_MODE=direct
# Set to "mcp" to force agents -> MCP server -> DB/AlloyDB routing.

# Optional AlloyDB metadata for docs / toolbox wiring
ALLOYDB_PROJECT=
ALLOYDB_REGION=
ALLOYDB_CLUSTER=
ALLOYDB_INSTANCE=
ALLOYDB_DATABASE=cure_quest
ALLOYDB_USER=
ALLOYDB_PASSWORD=

# Safety and behavior
OCR_CONFIDENCE_THRESHOLD=0.85
ACUTE_CONDITION_LOOKBACK_DAYS=180

# Google ADK / Gemini
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-pro

# Local MCP server
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m cure_quest.mcp.server
