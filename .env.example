# App
APP_NAME=Cure-Quest
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_API_KEY=

# Database
DATABASE_URL=sqlite:///./cure_quest.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cure_quest
# Example AlloyDB-compatible SQLAlchemy URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cure_quest

# Brain transport
BRAIN_GATEWAY_MODE=direct
# Set to "mcp" to force agents -> MCP server -> DB/AlloyDB routing.

# Optional AlloyDB metadata for docs / toolbox wiring
ALLOYDB_PROJECT=
ALLOYDB_REGION=
ALLOYDB_CLUSTER=
ALLOYDB_INSTANCE=
ALLOYDB_DATABASE=cure_quest
ALLOYDB_USER=
ALLOYDB_PASSWORD=

# Safety and behavior
OCR_CONFIDENCE_THRESHOLD=0.85
ACUTE_CONDITION_LOOKBACK_DAYS=180
INTEGRATION_MAX_RETRIES=2
INTEGRATION_RETRY_DELAY_MS=300

# Google ADK / Gemini
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-pro
GOOGLE_OAUTH_CLIENT_FILE=credentials/google_oauth_client.json
GOOGLE_DRIVE_TOKEN_FILE=credentials/google_drive_token.json
GOOGLE_CALENDAR_TOKEN_FILE=credentials/google_calendar_token.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary

# BigQuery analytics
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=cure_quest
BIGQUERY_TABLE_ID=integration_events

# External clinical/location APIs
OPENFDA_API_KEY=
GOOGLE_MAPS_API_KEY=
MEDICAL_MODEL_BACKEND=placeholder
HUGGINGFACE_HUB_TOKEN=
MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
MEDSIGLIP_MODEL_ID=google/medsiglip-448
MEDICAL_EMBEDDING_DIMENSIONS=768
MEDICAL_VECTOR_TABLE_NAME=medical_memories_vector

# Asana HITL ticketing
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
ASANA_ASSIGNEE_GID=
ASANA_WORKSPACE_GID=
ASANA_TASK_DUE_ON=

# Local MCP server
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m cure_quest.mcp.server
